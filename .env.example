# Postgres (packages/db + apps/api)
DATABASE_URL="postgresql://marka:marka@localhost:5432/marka?schema=public"
# Set only if using a pooled connection (PgBouncer / Neon / Supabase pooler);
# Prisma uses it for migrations while DATABASE_URL is used at runtime.
DIRECT_URL=""

# Session/auth
# 32+ byte random string. Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-real-secret"

# Cookies are scoped to this domain in production so consumer/business/backoffice
# subdomains can share the auth session set by apps/api. Leave empty in local dev.
COOKIE_DOMAIN=""

NODE_ENV="development"

# apps/api
# Comma-separated list of origins allowed to call the API with credentials.
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002"

# Frontend apps (browser → API). Never put secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Seed script (packages/db) — first Backoffice super_admin. Public admin
# self-registration does not exist; this is the only bootstrap path.
ADMIN_SEED_EMAIL="admin@marka.ia"
ADMIN_SEED_PASSWORD="change-me-now"
