// marka.ia — Prisma schema
// Multi-tenant model: every business-owned record carries an explicit
// establishmentId. Application code must always filter by it — see
// packages/shared/src/tenant docs and apps/api/lib/tenant.ts for the
// server-side guard that enforces this on every request.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

// Shared identity for the Consumer and Business apps. A single person can be
// a customer of one salon and the owner of another — permissions are always
// derived per-establishment via EstablishmentMember, never from this table.
model User {
  id                String    @id @default(cuid())
  email             String    @unique
  phone             String?
  passwordHash      String
  name              String
  emailVerifiedAt   DateTime?
  status            UserStatus @default(ACTIVE)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sessions          Session[]
  memberships       EstablishmentMember[]
  customerProfiles  Customer[]
  favoriteEstablishments FavoriteEstablishment[]
  favoriteProfessionals  FavoriteProfessional[]
  passwordResets    PasswordResetToken[]
  emailVerifications EmailVerificationToken[]

  @@map("users")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

// Backoffice identity. Deliberately separate from User: no public
// registration endpoint, no crossover with Consumer/Business permissions.
model Administrator {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String
  role         AdminRole
  status       AdminStatus   @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  sessions           AdminSession[]
  supportTicketsCreated SupportTicket[] @relation("SupportTicketCreatedBy")
  supportTicketsAssigned SupportTicket[] @relation("SupportTicketAssignee")

  @@map("administrators")
}

enum AdminStatus {
  ACTIVE
  SUSPENDED
}

// Matches apps/backoffice/lib/types.ts Role exactly.
enum AdminRole {
  super_admin
  finance
  support
  operations
  product
  read_only
}

// Opaque token stored as a SHA-256 hash; only the raw token ever leaves the
// server (in the cookie). Losing the DB does not leak live sessions.
model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model AdminSession {
  id              String   @id @default(cuid())
  administratorId String
  tokenHash       String   @unique
  userAgent       String?
  ip              String?
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime @default(now())

  administrator Administrator @relation(fields: [administratorId], references: [id], onDelete: Cascade)

  @@index([administratorId])
  @@map("admin_sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

// ---------------------------------------------------------------------------
// Tenant
// ---------------------------------------------------------------------------

model Establishment {
  id        String                @id @default(cuid())
  name      String
  slug      String                @unique
  document  String?
  category  EstablishmentCategory
  status    EstablishmentStatus   @default(trial)
  timezone  String                @default("America/Sao_Paulo")
  phone     String?
  city      String?
  state     String?
  address   String?
  // Public Consumer-facing fields — null/empty means "not configured", never invented.
  description          String?
  photoUrls            String[] @default([])
  hoursText            String?
  // Used only for slot generation when hoursText alone is not enough to parse.
  // Defaults match a typical beauty-business day; establishments can change them.
  slotStartHour        Int      @default(9)
  slotEndHour          Int      @default(19)
  acceptsLocalPayment  Boolean  @default(true)
  acceptsOnlinePayment Boolean  @default(false)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  members            EstablishmentMember[]
  memberInvites      MemberInvite[]
  ownershipTransfers OwnershipTransfer[]
  professionals      Professional[]
  services      Service[]
  customers     Customer[]
  appointments  Appointment[]
  payments      Payment[]
  products      Product[]
  stockMovements StockMovement[]
  campaigns     Campaign[]
  subscription  Subscription?
  auditLogs     AuditLog[]
  favoritedBy   FavoriteEstablishment[]
  supportTickets SupportTicket[]
  ambassadorProfile   AmbassadorProfile?
  referredByReferral  Referral?

  @@map("establishments")
}

// Matches apps/consumer + apps/estabelecimento CategoryId exactly.
enum EstablishmentCategory {
  nails
  barbearia
  lash_designer @map("lash-designer")
}

// Matches apps/backoffice/lib/types.ts EstablishmentStatus exactly.
enum EstablishmentStatus {
  trial
  active
  inactive
  suspended
  canceled
}

// The tenant-membership join: this is the single source of truth for "who
// can act on this establishment, with what role". Every authorization check
// in apps/api goes through this table — never trust an establishmentId
// supplied by the client without verifying membership here first.
model EstablishmentMember {
  id              String            @id @default(cuid())
  establishmentId String
  userId          String
  role            BusinessRole
  status          MemberStatus      @default(ACTIVE)
  invitedAt       DateTime          @default(now())
  joinedAt        DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  professional  Professional?

  @@unique([establishmentId, userId])
  @@index([userId])
  @@map("establishment_members")
}

enum MemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

// An invite exists independently of EstablishmentMember because the invited
// person may not have a User account yet (userId can't be known up front).
// It only turns into an EstablishmentMember row at accept time, once we
// know the userId — see apps/api/app/api/auth/invite/accept.
model MemberInvite {
  id              String       @id @default(cuid())
  establishmentId String
  email           String
  role            BusinessRole
  tokenHash       String       @unique
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime     @default(now())

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([establishmentId])
  @@index([email])
  @@map("member_invites")
}

// Matches apps/estabelecimento/lib/types.ts Role exactly.
enum BusinessRole {
  OWNER
  ADMIN
  MANAGER
  PROFESSIONAL
  STAFF
}

// Deliberately not modeled on MemberInvite: both sides are already existing
// EstablishmentMember rows (no email/account-creation step), and the role
// this grants is fixed (OWNER) rather than caller-supplied — reusing
// MemberInvite would mean allowing role: OWNER through the generic invite
// path, which is exactly what must never happen. At most one live transfer
// per establishment — see apps/api/app/api/business/[establishmentId]/
// ownership/transfer, which revokes any previous pending one on a new call.
model OwnershipTransfer {
  id              String    @id @default(cuid())
  establishmentId String
  fromMemberId    String
  toMemberId      String
  tokenHash       String    @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([establishmentId])
  @@map("ownership_transfers")
}

// ---------------------------------------------------------------------------
// Catalog & scheduling
// ---------------------------------------------------------------------------

// Professional-specific profile, 1:1 with a member whose role is
// PROFESSIONAL. Kept separate from EstablishmentMember so scheduling data
// doesn't bloat the membership/auth table.
model Professional {
  id                String   @id @default(cuid())
  establishmentId   String
  memberId          String   @unique
  bio               String?
  photoUrl          String?
  specialties       String[]
  commissionPercent Decimal  @default(0) @db.Decimal(5, 2)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  member        EstablishmentMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  services      ProfessionalService[]
  appointments  Appointment[]
  favoritedBy   FavoriteProfessional[]

  @@index([establishmentId])
  @@map("professionals")
}

model Service {
  id              String   @id @default(cuid())
  establishmentId String
  name            String
  description     String?
  durationMinutes Int
  price           Decimal  @db.Decimal(10, 2)
  category        String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  professionals ProfessionalService[]
  appointments  Appointment[]

  @@index([establishmentId])
  @@map("services")
}

model ProfessionalService {
  professionalId String
  serviceId      String

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([professionalId, serviceId])
  @@map("professional_services")
}

// Tenant-scoped CRM record. May optionally link to a Consumer-app User
// account (userId); the two identities are intentionally decoupled since a
// walk-in customer may never create an account.
model Customer {
  id              String   @id @default(cuid())
  establishmentId String
  userId          String?
  name            String
  phone           String?
  email           String?
  notes           String?
  tags            String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointments  Appointment[]
  payments      Payment[]

  // One CRM profile per (establishment, user) when the customer has an account.
  // Walk-ins keep userId null — Postgres allows multiple NULLs in a unique pair.
  @@unique([establishmentId, userId])
  @@index([establishmentId])
  @@index([userId])
  @@map("customers")
}

// ---------------------------------------------------------------------------
// Consumer favorites — separate tables so uniqueness is exact (no nullable
// unique columns) and establishment vs professional cannot be mixed in one row.
// ---------------------------------------------------------------------------

model FavoriteEstablishment {
  userId          String
  establishmentId String
  createdAt       DateTime @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@id([userId, establishmentId])
  @@index([establishmentId])
  @@map("favorite_establishments")
}

model FavoriteProfessional {
  userId         String
  professionalId String
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@id([userId, professionalId])
  @@index([professionalId])
  @@map("favorite_professionals")
}

model Appointment {
  id              String            @id @default(cuid())
  establishmentId String
  customerId      String
  professionalId  String
  serviceId       String
  startAt         DateTime
  endAt           DateTime
  status          AppointmentStatus @default(AGUARDANDO)
  price           Decimal           @db.Decimal(10, 2)
  notes           String?
  createdByUserId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  professional  Professional  @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  service       Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  payments      Payment[]

  @@index([establishmentId, startAt])
  @@index([professionalId, startAt])
  @@map("appointments")
}

// Business-side operational vocabulary — matches
// apps/estabelecimento/lib/types.ts AppointmentStatus. The Consumer app uses
// a simplified BookingStatus for its own UI; apps/api maps between the two
// in the JSON response, the DB keeps a single canonical status.
enum AppointmentStatus {
  AGUARDANDO
  CONFIRMADO
  CONCLUIDO
  CANCELADO
  NO_SHOW
  BLOQUEADO
}

// ---------------------------------------------------------------------------
// Payments — deliberately decoupled from any single gateway. `provider` is
// what differs per integration; `method`/`status` are gateway-agnostic.
// ---------------------------------------------------------------------------

model Payment {
  id              String          @id @default(cuid())
  establishmentId String
  appointmentId   String?
  customerId      String?
  amount          Decimal         @db.Decimal(10, 2)
  currency        String          @default("BRL")
  method          PaymentMethod
  provider        PaymentProvider @default(MANUAL)
  providerRef     String?
  status          PaymentStatus   @default(PENDING)
  paidAt          DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([establishmentId])
  @@map("payments")
}

enum PaymentMethod {
  PIX
  CARD
  CASH
  OTHER
}

enum PaymentProvider {
  MANUAL
  STRIPE
  MERCADO_PAGO
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELED
}

// ---------------------------------------------------------------------------
// Products & stock — stock is an append-only ledger (StockMovement); current
// stock is a cached counter on Product updated transactionally by the ledger
// write, so the number displayed is fast to read but always reconstructable.
// ---------------------------------------------------------------------------

model Product {
  id              String   @id @default(cuid())
  establishmentId String
  name            String
  sku             String?
  unit            String   @default("un")
  costPrice       Decimal  @default(0) @db.Decimal(10, 2)
  price           Decimal  @default(0) @db.Decimal(10, 2)
  minStock        Int      @default(0)
  currentStock    Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  establishment  Establishment   @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]

  @@index([establishmentId])
  @@map("products")
}

model StockMovement {
  id              String       @id @default(cuid())
  establishmentId String
  productId       String
  type            StockMoveType
  quantity        Int
  reason          String?
  createdByUserId String?
  createdAt       DateTime     @default(now())

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([establishmentId])
  @@index([productId])
  @@map("stock_movements")
}

enum StockMoveType {
  IN
  OUT
  ADJUSTMENT
}

// ---------------------------------------------------------------------------
// Marketing (MVP placeholder — no send integration yet)
// ---------------------------------------------------------------------------

model Campaign {
  id              String         @id @default(cuid())
  establishmentId String
  name            String
  channel         CampaignChannel
  status          CampaignStatus @default(DRAFT)
  audience        Json?
  scheduledAt     DateTime?
  sentAt          DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([establishmentId])
  @@map("campaigns")
}

enum CampaignChannel {
  EMAIL
  WHATSAPP
  PUSH
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELED
}

// ---------------------------------------------------------------------------
// Platform billing — marka.ia's own subscription of an Establishment to a Plan.
// ---------------------------------------------------------------------------

model Plan {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  priceMonthly Decimal  @db.Decimal(10, 2)
  features     Json?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                String             @id @default(cuid())
  establishmentId   String             @unique
  planId            String
  status            SubscriptionStatus @default(TRIALING)
  provider          String?
  providerRef       String?
  currentPeriodEnd  DateTime?
  canceledAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  plan          Plan          @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@map("subscriptions")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id              String       @id @default(cuid())
  actorType       AuditActorType
  actorId         String?
  establishmentId String?
  action          String
  targetType      String?
  targetId        String?
  metadata        Json?
  ip              String?
  userAgent       String?
  createdAt       DateTime     @default(now())

  establishment Establishment? @relation(fields: [establishmentId], references: [id], onDelete: SetNull)

  @@index([establishmentId])
  @@index([actorType, actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum AuditActorType {
  USER
  ADMINISTRATOR
  SYSTEM
}

// ---------------------------------------------------------------------------
// Backoffice support + platform settings
// ---------------------------------------------------------------------------

model SupportTicket {
  id              String                @id @default(cuid())
  subject         String
  description     String?
  type            SupportTicketType
  status          SupportTicketStatus   @default(open)
  priority        SupportTicketPriority @default(medium)
  customerName    String
  establishmentId String?
  createdById     String?
  assigneeId      String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  resolvedAt      DateTime?

  establishment Establishment? @relation(fields: [establishmentId], references: [id], onDelete: SetNull)
  createdBy     Administrator? @relation("SupportTicketCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  assignee      Administrator? @relation("SupportTicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([status, priority])
  @@index([establishmentId])
  @@index([createdAt])
  @@map("support_tickets")
}

enum SupportTicketType {
  billing
  technical
  onboarding
}

enum SupportTicketStatus {
  open
  in_progress
  resolved
}

enum SupportTicketPriority {
  high
  medium
  low
}

// Singleton platform settings row (id is always "default").
model PlatformSettings {
  id        String   @id @default("default")
  brandName String   @default("marka.ia")
  locale    String   @default("pt-BR")
  features  Json
  updatedAt DateTime @updatedAt
  updatedById String?

  @@map("platform_settings")
}

// ---------------------------------------------------------------------------
// "Indique e Ganhe" — ambassador referral program. Deliberately not modeled
// as a BusinessRole: an ambassador is an attribute of the Establishment
// (granted only by an Administrator), not a per-member role. Frontend
// visibility AND the API guard (apps/api/lib/ambassador.ts) both key off
// AmbassadorProfile.status, never off a client-supplied flag.
// ---------------------------------------------------------------------------

model AmbassadorProfile {
  id               String            @id @default(cuid())
  establishmentId  String            @unique
  // Permanent once generated — never regenerated on demand (see product spec).
  code             String            @unique
  status           AmbassadorStatus  @default(ACTIVE)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  // Set only when status becomes REMOVED. The row itself is never deleted —
  // referrals/commissions/withdrawals must survive removal intact.
  removedAt        DateTime?
  createdByAdminId String?

  establishment Establishment          @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  referrals     Referral[]
  commissions   Commission[]
  withdrawals   AmbassadorWithdrawal[]
  events        ReferralEvent[]

  @@map("ambassador_profiles")
}

enum AmbassadorStatus {
  ACTIVE
  PAUSED
  SUSPENDED
  REMOVED
}

// One row per indicated establishment. Created at first link click (PENDING,
// referredEstablishmentId null) so attribution survives navigation between
// the link click and the end of signup — see visitorRef.
model Referral {
  id     String @id @default(cuid())
  ambassadorId String

  // Unique globally: a given establishment can only ever be attributed to
  // one ambassador, and only once.
  referredEstablishmentId String? @unique
  // Token carried by the mk_ref cookie (apps/estabelecimento/app/indique/[code]).
  // Deduplicates repeat clicks from the same visitor before signup completes.
  visitorRef String @unique

  status      ReferralStatus @default(PENDING)
  source      String?
  createdAt   DateTime       @default(now())
  convertedAt DateTime?

  ambassador            AmbassadorProfile @relation(fields: [ambassadorId], references: [id], onDelete: Cascade)
  referredEstablishment Establishment?    @relation(fields: [referredEstablishmentId], references: [id], onDelete: SetNull)
  commissions           Commission[]
  events                ReferralEvent[]

  @@index([ambassadorId])
  @@map("referrals")
}

enum ReferralStatus {
  PENDING
  SIGNED_UP
  UNDER_REVIEW
  ACTIVE
  CANCELED
}

model Commission {
  id           String         @id @default(cuid())
  ambassadorId String
  referralId   String
  kind         CommissionKind
  // e.g. "2026-09" for a RECURRING commission — the idempotency key that
  // stops the same billing cycle from generating the commission twice.
  periodKey    String?
  amount       Decimal          @db.Decimal(10, 2)
  status       CommissionStatus @default(PENDING)
  createdAt    DateTime         @default(now())
  approvedAt   DateTime?
  paidAt       DateTime?
  canceledAt   DateTime?

  ambassador AmbassadorProfile @relation(fields: [ambassadorId], references: [id], onDelete: Cascade)
  referral   Referral          @relation(fields: [referralId], references: [id], onDelete: Cascade)

  @@unique([ambassadorId, referralId, kind, periodKey])
  @@index([ambassadorId])
  @@map("commissions")
}

enum CommissionKind {
  BONUS
  RECURRING
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELED
}

model AmbassadorWithdrawal {
  id                  String           @id @default(cuid())
  ambassadorId        String
  amount              Decimal          @db.Decimal(10, 2)
  status              WithdrawalStatus @default(PENDING)
  requestedAt         DateTime         @default(now())
  processedAt         DateTime?
  processedByAdminId  String?
  rejectionReason     String?

  ambassador AmbassadorProfile @relation(fields: [ambassadorId], references: [id], onDelete: Cascade)

  @@index([ambassadorId])
  @@map("ambassador_withdrawals")
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  PAID
  REJECTED
}

// Append-only funnel/audit trail for the referral program itself (distinct
// from AuditLog, which covers admin/financial actions on these records).
model ReferralEvent {
  id           String            @id @default(cuid())
  ambassadorId String
  referralId   String?
  type         ReferralEventType
  metadata     Json?
  createdAt    DateTime          @default(now())

  ambassador AmbassadorProfile @relation(fields: [ambassadorId], references: [id], onDelete: Cascade)
  referral   Referral?         @relation(fields: [referralId], references: [id], onDelete: SetNull)

  @@index([ambassadorId])
  @@index([referralId])
  @@map("referral_events")
}

enum ReferralEventType {
  LINK_ACCESSED
  SIGNUP_STARTED
  SIGNUP_COMPLETED
  ESTABLISHMENT_ACTIVATED
  PLAN_SUBSCRIBED
  PAYMENT_CONFIRMED
  COMMISSION_CREATED
  COMMISSION_APPROVED
  COMMISSION_CANCELED
  WITHDRAWAL_REQUESTED
  WITHDRAWAL_PAID
}

// Singleton settings row (id is always "default"), mirroring PlatformSettings.
// Kept flexible on purpose: changing commission rules must never require a
// schema migration — see packages/shared/src/ambassador-commission.ts.
model AmbassadorProgramSettings {
  id                  String              @id @default("default")
  active              Boolean             @default(true)
  commissionModel     CommissionModel     @default(HYBRID)
  commissionType      CommissionValueType @default(FIXED)
  bonusAmount         Decimal?            @db.Decimal(10, 2)
  recurringPercent    Decimal?            @db.Decimal(5, 2)
  recurringFixed      Decimal?            @db.Decimal(10, 2)
  minWithdrawalAmount Decimal             @default(100) @db.Decimal(10, 2)
  approvalPeriodDays  Int                 @default(7)
  cancellationRules   String?
  updatedAt           DateTime            @updatedAt
  updatedByAdminId    String?

  @@map("ambassador_program_settings")
}

enum CommissionModel {
  ONE_TIME
  RECURRING
  HYBRID
}

enum CommissionValueType {
  PERCENT
  FIXED
}
